{
    "name": "tezmanian/utils-crypto",
    "type": "library",
    "description": "Authenticated AES-GCM encryption for PHP — supports AES-128/192/256-GCM with random nonces, tag verification, and a strict enum-based cipher allowlist. PHP 8.3+, requires ext-openssl.",
    "keywords": [
        "crypto",
        "aes",
        "aes-gcm",
        "encryption",
        "php"
    ],
    "homepage": "https://github.com/tezmanian/tez-utils-crypto",
    "license": "MIT",
    "authors": [
        {
            "name": "René Halberstadt",
            "email": "tezmanian@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/tezmanian/tez-utils-crypto/issues",
        "source": "https://github.com/tezmanian/tez-utils-crypto"
    },
    "autoload": {
        "psr-4": {
            "Tezmanian\\Utils\\Crypto\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tezmanian\\Utils\\Tests\\Crypto\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3",
        "ext-openssl": "*",
        "tezmanian/utils-enum": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "jetbrains/phpstorm-attributes": "^1.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse",
        "test": "phpunit --testsuite Unit --colors=always"
    }
}
